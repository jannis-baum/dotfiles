# see /Applications/sioyek.app/Contents/MacOS/keys.config
# command is D

# zoom with normal bindings
zoom_in <D-=>
fit_to_page_width <D-0>
zoom_out <D-->

# ruler
enter_visual_mark_mode i

copy <D-c>
previous_page u
next_page d

# non-customized but useful to check on
# backspace: go back in history, e.g. to go back after clicking on a link
